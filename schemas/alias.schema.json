{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-catalog.example.cn/schemas/alias.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "alias_set_id",
    "entries",
    "evidence",
    "field_annotations"
  ],
  "properties": {
    "$schema": { "const": "https://llm-catalog.example.cn/schemas/alias.schema.json" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "alias_set_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "provider_id", "target_type", "target_id"],
        "properties": {
          "alias": { "type": "string", "minLength": 1, "maxLength": 200 },
          "provider_id": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/identifier" },
              { "type": "null" }
            ]
          },
          "target_type": { "enum": ["canonical", "offering", "alias"] },
          "target_id": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/source" }
    },
    "field_annotations": { "$ref": "common.schema.json#/$defs/field_annotations" }
  }
}
