{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-catalog.example.cn/schemas/provider-shard.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "generated_at",
    "provider",
    "models",
    "offerings",
    "aliases"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "provider": { "$ref": "provider.schema.json" },
    "models": { "type": "array", "items": { "$ref": "canonical-model.schema.json" } },
    "offerings": { "type": "array", "items": { "$ref": "offering.schema.json" } },
    "aliases": { "type": "array", "items": { "$ref": "alias.schema.json" } }
  }
}
