{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-catalog.example.cn/schemas/models-dev-official-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "review_set_id",
    "source_snapshot_sha256",
    "reviewed_at",
    "reviews"
  ],
  "properties": {
    "$schema": {
      "const": "https://llm-catalog.example.cn/schemas/models-dev-official-review.schema.json"
    },
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "review_set_id": { "const": "models-dev-2026-official-review" },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offering_id",
          "provider_id",
          "canonical_id",
          "observed_api_model_id",
          "review_status",
          "reviewed_at",
          "verified_fields",
          "official_api_model_id",
          "official_protocols",
          "runtime_disposition",
          "summary",
          "evidence"
        ],
        "properties": {
          "offering_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "provider_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "canonical_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "observed_api_model_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "review_status": {
            "enum": [
              "official_api_verified",
              "official_model_verified",
              "official_route_unavailable",
              "official_evidence_not_found"
            ]
          },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "verified_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "model_identity",
                "api_model_id",
                "protocols",
                "lifecycle",
                "limits",
                "modalities",
                "agent_capabilities",
                "reasoning",
                "sampling"
              ]
            }
          },
          "official_api_model_id": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 200 },
              { "const": "unknown" }
            ]
          },
          "official_protocols": { "$ref": "common.schema.json#/$defs/unknown_protocols" },
          "runtime_disposition": { "const": "keep_fail_closed" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "evidence": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "common.schema.json#/$defs/source" },
                {
                  "type": "object",
                  "properties": {
                    "source_type": {
                      "enum": [
                        "official_docs",
                        "official_api",
                        "official_model_card",
                        "official_repository"
                      ]
                    }
                  },
                  "required": ["source_type"]
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "review_status": { "const": "official_api_verified" } },
              "required": ["review_status"]
            },
            "then": {
              "properties": {
                "official_api_model_id": { "type": "string", "minLength": 1 },
                "evidence": { "type": "array", "minItems": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "review_status": { "enum": ["official_model_verified", "official_route_unavailable"] } },
              "required": ["review_status"]
            },
            "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
          },
          {
            "if": {
              "properties": { "review_status": { "const": "official_evidence_not_found" } },
              "required": ["review_status"]
            },
            "then": {
              "properties": {
                "official_api_model_id": { "const": "unknown" },
                "official_protocols": { "const": "unknown" },
                "evidence": { "type": "array", "maxItems": 0 }
              }
            }
          }
        ]
      }
    }
  }
}
