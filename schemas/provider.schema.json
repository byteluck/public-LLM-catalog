{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-catalog.example.cn/schemas/provider.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "provider_id",
    "name",
    "website",
    "domestic_access",
    "api_key_required",
    "status",
    "protocols",
    "public_base_urls",
    "evidence",
    "field_annotations"
  ],
  "properties": {
    "$schema": { "const": "https://llm-catalog.example.cn/schemas/provider.schema.json" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "provider_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "website": { "type": "string", "format": "uri" },
    "domestic_access": { "$ref": "common.schema.json#/$defs/tri_state" },
    "api_key_required": { "$ref": "common.schema.json#/$defs/tri_state" },
    "status": { "enum": ["active", "migration", "deprecated", "retired", "unknown"] },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/protocol" }
    },
    "public_base_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "url", "region"],
        "properties": {
          "protocol": { "$ref": "common.schema.json#/$defs/protocol" },
          "url": { "type": "string", "format": "uri" },
          "region": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/source" }
    },
    "field_annotations": { "$ref": "common.schema.json#/$defs/field_annotations" }
  }
}
