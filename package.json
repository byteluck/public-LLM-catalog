{
  "name": "public-llm-catalog-cn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate && npm run check:determinism && npm run check:generated",
    "check:determinism": "tsx scripts/check-determinism.ts",
    "check:generated": "npm run build && git diff --exit-code -- dist snapshots",
    "lint": "eslint .",
    "probe": "tsx scripts/probe.ts",
    "preview": "npm run build && tsx scripts/preview.ts",
    "promote:models-dev-2026": "tsx scripts/promote-models-dev-2026.ts --write",
    "review:models-dev-2026": "tsx scripts/generate-models-dev-2026-reviews.ts",
    "publish": "tsx scripts/publish.ts",
    "sync": "tsx scripts/sync-upstreams.ts && tsx scripts/sync-models-dev-2026.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "22.17.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
